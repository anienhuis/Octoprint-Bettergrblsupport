<div id="probe_panel" style="border: 1px solid; border-radius: 10px; padding: 12px; max-width: 430px;">
   <div style="display: flex; flex-wrap: wrap; gap: 10px;">
      <div style="flex: 1 1 180px;">
         <label>Probe Depth</label>
         <div style="display: flex; align-items: center; gap: 6px;">
            <input type="number" min="0" step="0.1" class="input-mini"
               data-bind="value: probeDepth, event: { focus: function(d, e) { handleFocus(e) } }">
            <span>mm</span>
         </div>
      </div>

      <div style="flex: 1 1 180px;">
         <label>Probe Feedrate</label>
         <div style="display: flex; align-items: center; gap: 6px;">
            <input type="number" min="1" step="1" class="input-mini"
               data-bind="value: probeFeedrate, event: { focus: function(d, e) { handleFocus(e) } }">
            <span>mm/min</span>
         </div>
      </div>

      <div style="flex: 1 1 180px;">
         <label>Touch Plate Thickness</label>
         <div style="display: flex; align-items: center; gap: 6px;">
            <input type="number" min="0" step="0.1" class="input-mini"
               data-bind="value: touchPlateThickness, event: { focus: function(d, e) { handleFocus(e) } }">
            <span>mm</span>
         </div>
      </div>

      <div style="flex: 1 1 180px;">
         <label>Retraction Distance</label>
         <div style="display: flex; align-items: center; gap: 6px;">
            <input type="number" min="0" step="0.1" class="input-mini"
               data-bind="value: retractionDistance, event: { focus: function(d, e) { handleFocus(e) } }">
            <span>mm</span>
         </div>
      </div>
   </div>

   <div style="margin-top: 10px;">
      <button class="btn" style="width: 120px; border: 1px solid;"
         data-bind="click: doProbe, enable: is_operational() && !is_printing() && state() == 'Idle'">Probe</button>
   </div>

   <div style="margin-top: 8px; min-height: 20px;">
      <span data-bind="text: probeStatus"></span>
   </div>
</div>
